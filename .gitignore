
# Agent
agent/.venv/
agent/__pycache__/
agent/data/agent_memory.db
# scan_offset.json is GIT-TRACKED on purpose: it's the round-robin company-scan
# cursor. If ignored, CI resets to 0 each run and re-scans the same first companies.
agent/*.pyc
agent/__pycache__/
agent/src/__pycache__/
agent/tests/__pycache__/
agent/data/indeed_cookies.json
agent/data/linkedin_cookies.json
__pycache__/

# Credentials — NEVER commit these (PUBLIC REPO!)
.env
.env.local
*.key
*.pem
*_cookies.json
agent/data/*_cookies.json
agent/data/apollo_cookies.json
agent/data/apollo_contacted.json
agent/data/contacted.json
contacted.json
**/cookies.json
**/credentials.json
**/secrets.json
agent/data/agent_memory.db

# Session state (contains live cookies — PUBLIC REPO, never commit)
agent/data/indeed_state.json
agent/data/*_state.json
# Runtime run artifacts
agent/screenshots/
agent/data/failed_jobs.json
agent/data/*_manual_jobs.json

# Persistent Chrome profile — contains LIVE Indeed login cookies (PUBLIC REPO, NEVER commit)
agent/.chrome-profile/
# Local scratch / dump / debug artifacts (not part of the flow)
agent/dump_*.py
agent/test_consent_salary_fix.py
agent/test_deep_greenhouse.py
agent/data/*.png
agent/data/*.html
agent/data/flow_transcript.json

# Dice login profile + cookies (never commit)
agent/.dice-profile/
agent/data/dice_cookies.json
